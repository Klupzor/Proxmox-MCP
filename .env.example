# Copy to .env and `chmod 600 .env` — the server refuses to start otherwise.
# See docs/setup.md for creating least-privilege tokens.

# read (default) | operate | admin
MCP_ACCESS_LEVEL=read

# --- Proxmox VE (https only) ---
PROXMOX_URL=https://pve.lan:8006
PROXMOX_TOKEN_ID=mcp@pve!mcp
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# Trust the Proxmox self-signed CA (copied from /etc/pve/pve-root-ca.pem)
PROXMOX_CA_FILE=certs/pve-root-ca.pem
# Optional allowlists (comma-separated); empty = everything the token can see
PROXMOX_ALLOWED_NODES=
PROXMOX_ALLOWED_VMIDS=

# --- Portainer (https only) ---
PORTAINER_URL=https://portainer.lan:9443
PORTAINER_API_KEY=ptr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORTAINER_CA_FILE=certs/homelab-ca.pem
PORTAINER_ALLOWED_ENDPOINTS=

# --- Proxmox host diagnostics over SSH (optional; all four are required together) ---
# See docs/setup.md section 8. The key must be bound to host/mcp-diag.sh on the host.
# PROXMOX_SSH_HOST=192.168.1.28
# PROXMOX_SSH_NODE=proxmox
# PROXMOX_SSH_KEY_FILE=certs/proxmox-mcp-ssh
# PROXMOX_SSH_KNOWN_HOSTS_FILE=certs/proxmox-known-hosts
# PROXMOX_SSH_USER=root
# PROXMOX_SSH_PORT=22

# --- Optional ---
# HTTP_TIMEOUT_MS=15000
# AUDIT_LOG_PATH=~/.local/state/proxmox-mcp/audit.jsonl (default)
# STACKS_DIR=stacks
# HOST_DIR=host

# Copy to .env, chmod 600, and generate real values:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
# HTTPS: base64 of the PEM certificate/key issued by the homelab CA (see docs/setup.md):
#   base64 < certs/nextcloud-server.crt | tr -d '\n'
NC_TLS_CERT_B64=changeme
NC_TLS_KEY_B64=changeme
